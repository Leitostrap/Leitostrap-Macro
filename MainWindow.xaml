<Window x:Class="LeitostrapMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leitostrap Macro"
        Width="920" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="True"
        Icon="Leitostrap.ico"
        PreviewKeyDown="PreviewKeyDownHandler">
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    <Border x:Name="RootBorder" CornerRadius="0" Background="#080808" BorderBrush="#181818" BorderThickness="1">
        
        <Grid ClipToBounds="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="ThemeCanvas" IsHitTestVisible="False" Background="Transparent" Grid.RowSpan="2"/>

            <!-- ═══ TITLE BAR ═══ -->
            <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="#080808">
                <Grid Margin="22,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Leitostrap.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LEITO" Foreground="White" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="STRAP" Foreground="#FF333333" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <Border Background="#FF151515" CornerRadius="6" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0 beta" Foreground="#FF444444" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Width="30" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="BtnMinimize_Click" Template="{StaticResource NoneBtn}">
                            <TextBlock Text="&#x2500;" Foreground="#FF555555" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Width="30" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="BtnMaximize_Click" Margin="2,0,0,0" Template="{StaticResource NoneBtn}">
                            <TextBlock Text="&#x25A1;" FontFamily="Segoe UI Symbol" Foreground="#FF555555" FontSize="11" Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnClose" Width="30" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="BtnClose_Click" Margin="2,0,0,0" Template="{StaticResource NoneBtn}">
                            <TextBlock Text="&#x2715;" Foreground="#FF555555" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ GAME SELECTION ═══ -->
            <Grid x:Name="GameSelectionScreen" Grid.Row="1" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="40,34,40,0">
                    <TextBlock Text="Select Platform" Foreground="#FF888888" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" />
                    <TextBlock Text="Choose a category to find macros" Foreground="#FF222222" FontSize="11" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="20,24,20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ModernScrollViewer}">
                    <StackPanel Margin="20,0,20,20">
                        <!-- UNIVERSAL SECTION -->
                        <TextBlock Text="Universal" Foreground="#FF555555" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                        <Border x:Name="GameCard_Universal" Cursor="Hand"
                                Background="#0E0E0E" CornerRadius="18" BorderBrush="#161616" BorderThickness="1"
                                MouseLeftButtonUp="GameCard_Universal_Click" HorizontalAlignment="Stretch"
                                Height="100" Padding="0" Margin="0,0,0,24">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CardScaleUniv" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleUniv" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleUniv" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleUniv" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleUniv" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid Margin="22,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="16" Background="#111111" ClipToBounds="True" VerticalAlignment="Center" BorderBrush="#1A1A1A" BorderThickness="1">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Universal Macros" Foreground="White" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="AutoClicker, AutoJump, and more..." Foreground="#FF333333" FontSize="11" FontFamily="Segoe UI" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" Background="#141414" CornerRadius="10" Padding="18,8" BorderBrush="#1C1C1C" BorderThickness="1">
                                    <TextBlock Text="OPEN" Foreground="#FF555555" FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ROBLOX SECTION -->
                        <TextBlock Text="Roblox" Foreground="#FF555555" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                        
                        <Border x:Name="GameCard_TSB" Cursor="Hand"
                                Background="#0E0E0E" CornerRadius="18" BorderBrush="#161616" BorderThickness="1"
                                MouseLeftButtonUp="GameCard_TSB_Click" 
                                Height="150" Padding="0" Margin="0,0,12,12">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel Margin="16" HorizontalAlignment="Center">
                                
                                <Border Width="64" Height="64" CornerRadius="16" Background="#111111" ClipToBounds="True" HorizontalAlignment="Center" BorderBrush="#1A1A1A" BorderThickness="1">
                                    <Image Source="resources/tsb.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="TSB" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Best macros for The Strongest Battlegrounds" Foreground="#FF333333" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" FontFamily="Segoe UI" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Border Background="#141414" CornerRadius="8" Padding="24,6" BorderBrush="#1C1C1C" BorderThickness="1" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <TextBlock Text="OPEN" Foreground="#FF555555" FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="GameCard_Rivals" Cursor="Hand"
                                Background="#0E0E0E" CornerRadius="18" BorderBrush="#161616" BorderThickness="1"
                                MouseLeftButtonUp="GameCard_Rivals_Click" 
                                Height="150" Padding="0" Margin="0,0,12,12">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CardScaleRivals" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleRivals" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleRivals" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleRivals" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleRivals" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel Margin="16" HorizontalAlignment="Center">
                                
                                <Border Width="64" Height="64" CornerRadius="16" Background="#111111" ClipToBounds="True" HorizontalAlignment="Center" BorderBrush="#1A1A1A" BorderThickness="1">
                                    <Image Source="resources/Rivals.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Rivals" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Best macros for Rivals" Foreground="#FF333333" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" FontFamily="Segoe UI" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Border Background="#141414" CornerRadius="8" Padding="24,6" BorderBrush="#1C1C1C" BorderThickness="1" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <TextBlock Text="OPEN" Foreground="#FF555555" FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="GameCard_BloxFruits" Cursor="Hand"
                                Background="#0E0E0E" CornerRadius="18" BorderBrush="#161616" BorderThickness="1"
                                MouseLeftButtonUp="GameCard_BloxFruits_Click" 
                                Height="150" Padding="0" Margin="0,0,12,12">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CardScaleBlox" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleBlox" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleBlox" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="CardBloxBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#222222" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleBlox" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScaleBlox" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="CardBloxBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#161616" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Border x:Name="CardBloxBorder" CornerRadius="18" BorderBrush="#161616" BorderThickness="1" Background="Transparent">
                                <StackPanel Margin="16" HorizontalAlignment="Center">
                                    
                                    <Border Width="64" Height="64" CornerRadius="16" Background="#111111" ClipToBounds="True" HorizontalAlignment="Center" BorderBrush="#1A1A1A" BorderThickness="1">
                                        <Image Source="resources/BloxFruits.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Blox Fruits" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        <TextBlock Text="FOV Changer and more for Blox Fruits" Foreground="#FF333333" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" FontFamily="Segoe UI" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Background="#141414" CornerRadius="8" Padding="24,6" BorderBrush="#1C1C1C" BorderThickness="1" HorizontalAlignment="Center" Margin="0,14,0,0">
                                        <TextBlock Text="OPEN" Foreground="#FF555555" FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Border>

                                                </UniformGrid>
                        <TextBlock Text="More games coming soon..." Foreground="#FF1A1A1A" FontSize="10" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,10,0,26"/>
                    </StackPanel>

                </ScrollViewer>

                <!-- SETTINGS AND ABOUT -->
                <Grid Grid.Row="2" Margin="40,0,40,30">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnSettings" Template="{StaticResource PillBtn}" Padding="24,10" Margin="0,0,10,0" Click="BtnSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SETTINGS" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAbout" Template="{StaticResource PillBtn}" Padding="24,10" Click="BtnAbout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ABOUT" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ═══ MACRO CENTER ═══ -->

            <!-- ═══ MACRO CENTER ═══ -->
            <Grid x:Name="MacroCenterScreen" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="#0A0A0A">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="22,22,22,0">
                            <Button x:Name="BtnBack" Width="32" Height="32" Background="#111111" BorderThickness="0"
                                    Cursor="Hand" Click="BtnBack_Click" Padding="0"
                                    HorizontalAlignment="Left" BorderBrush="#1A1A1A">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="#FF555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#1A1A1A"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- TABS -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            
                            <StackPanel>
                        <!-- TAB: HUMBLED TWISTED -->
                        <Border x:Name="TabHumbled" Margin="16,4,16,4" Padding="12,12" Cursor="Hand"
                                Background="#111111" CornerRadius="8" BorderBrush="#1A1A1A" BorderThickness="1"
                                MouseLeftButtonDown="TabHumbled_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="1" Text="Humbled Twisted" Foreground="#FF777777" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="6" Padding="6,2">
                                    <TextBlock x:Name="TabStatus" Text="OFF" Foreground="#FF444444" FontSize="8" FontWeight="Bold" FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- TAB: INSTANT LEE -->
                        <Border x:Name="TabInstantLee" Margin="16,4,16,4" Padding="12,12" Cursor="Hand"
                                Background="Transparent" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"
                                MouseLeftButtonDown="TabInstantLee_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="1" Text="Instant Lee" Foreground="#FF555555" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="6" Padding="6,2">
                                    <TextBlock x:Name="TabInstantLeeStatus" Text="OFF" Foreground="#FF444444" FontSize="8" FontWeight="Bold" FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- TAB: LETHAL DASH -->
                        <Border x:Name="TabLethalDash" Margin="16,4,16,4" Padding="12,12" Cursor="Hand"
                                Background="Transparent" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"
                                MouseLeftButtonDown="TabLethalDash_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="1" Text="Lethal Dash" Foreground="#FF555555" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="6" Padding="6,2">
                                    <TextBlock x:Name="TabLethalDashStatus" Text="OFF" Foreground="#FF444444" FontSize="8" FontWeight="Bold" FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- TAB: BUNNY HOP -->
                        <Border x:Name="TabBunnyHop" Margin="16,4,16,4" Padding="12,12" Cursor="Hand" Visibility="Collapsed"
                                Background="Transparent" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"
                                MouseLeftButtonDown="TabBunnyHop_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="1" Text="Bunny Hop" Foreground="#FF555555" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="6" Padding="6,2">
                                    <TextBlock x:Name="TabBunnyHopStatus" Text="OFF" Foreground="#FF444444" FontSize="8" FontWeight="Bold" FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- TAB: PILLAR SLIDE -->
                        <Border x:Name="TabPillarSlide" Margin="16,4,16,4" Padding="12,12" Cursor="Hand" Visibility="Collapsed"
                                Background="Transparent" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"
                                MouseLeftButtonDown="TabPillarSlide_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="1" Text="Pillar Slide" Foreground="#FF555555" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="6" Padding="6,2">
                                    <TextBlock x:Name="TabPillarSlideStatus" Text="OFF" Foreground="#FF444444" FontSize="8" FontWeight="Bold" FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- TAB: AUTOCLICKER -->
